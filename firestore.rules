rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasValidMovieFields() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.id is string
        && request.resource.data.id.size() > 0;
    }

    // 1. User profile, private tracking list, and personal API keys
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Public community reviews for Nollywood films
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10;
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || request.auth.token.email != null
      );
    }

    // 3. Nigerian movie catalogue: Publicly readable; client writes require authenticated user and valid schema.
    // (Note: Server-side sync via scripts/syncMovies.js uses Firebase Admin SDK which bypasses client rules)
    match /custom_movies/{movieId} {
      allow read: if true;
      allow create: if isAuthenticated() && hasValidMovieFields();
      allow update: if isAuthenticated() && hasValidMovieFields() && (
        resource.data.addedByUserId == request.auth.uid ||
        resource.data.addedByUserId == null ||
        resource.data.addedByUserId == 'community-contributor' ||
        resource.data.addedByUserId == 'github-actions-sync' ||
        resource.data.addedByUserId == 'system-cloud-function'
      );
      allow delete: if isAuthenticated() && (
        resource.data.addedByUserId == request.auth.uid ||
        request.auth.token.email != null
      );
    }

    // 4. Public and user curated themed film collections
    match /custom_lists/{listId} {
      allow read: if resource.data.isPublic == true || isOwner(resource.data.creatorId);
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.creatorId);
    }

    // 5. System synchronization audit log (Publicly readable, writable only via Firebase Admin SDK)
    match /system_meta/{metaId} {
      allow read: if true;
      allow write: if false; // Server-side Firebase Admin SDK bypasses client security rules
    }
  }
}
